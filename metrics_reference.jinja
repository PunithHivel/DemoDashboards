## 🤖 AUTO-REMEDIATION ALGORITHM

```python
def fix_metric_violations(ag_data):
    """
    Automatically fix constraint violations in aggregated data
    """
    
    # 1. CODE DISTRIBUTION CHECK
    sum_work = ag_data.newwork + ag_data.rework + ag_data.maintenancework
    if sum_work != ag_data.commitlinesmodified:
        if sum_work < ag_data.commitlinesmodified:
            # Add unaccounted to new work
            ag_data.newwork += (ag_data.commitlinesmodified - sum_work)
        else:
            # Scale proportionally
            scale = ag_data.commitlinesmodified / sum_work
            ag_data.newwork = int(ag_data.newwork * scale)
            ag_data.rework = int(ag_data.rework * scale)
            ag_data.maintenancework = int(ag_data.maintenancework * scale)
    
    # 2. PR REVIEW STATUS CHECK
    if ag_data.unreviewedprcount > ag_data.prcount:
        ag_data.unreviewedprcount = ag_data.prcount
    if ag_data.unreviewedprcount < 0:
        ag_data.unreviewedprcount = 0
    
    # 3. FLASHY REVIEWS CONSTRAINT
    reviewed_count = ag_data.prcount - ag_data.unreviewedprcount
    if ag_data.flashyreviewedprcount > reviewed_count:
        ag_data.flashyreviewedprcount = reviewed_count
    if ag_data.flashyreviewedprcount < 0:
        ag_data.flashyreviewedprcount = 0
    
    # 4. HOTFIX CONSTRAINTS
    if ag_data.hotfixprcount > ag_data.deploymentfrequency:
        ag_data.hotfixprcount = ag_data.deploymentfrequency
    if ag_data.hotfixprcount > ag_data.prcount:
        ag_data.hotfixprcount = ag_data.prcount
    if ag_data.hotfixprcount < 0:
        ag_data.hotfixprcount = 0
    
    # 5. LARGE PR CONSTRAINTS
    if ag_data.largesizeprcount > ag_data.prcount:
        ag_data.largesizeprcount = ag_data.prcount
    if ag_data.largesizeprcount_dynamic > ag_data.prcount:
        ag_data.largesizeprcount_dynamic = ag_data.prcount
    
    # 6. MERGED PR CONSTRAINTS
    if ag_data.prmergedcount > ag_data.prcount:
        ag_data.prmergedcount = ag_data.prcount
    
    # 7. OPEN PR CONSTRAINTS
    if ag_data.openprcount > ag_data.prcount:
        ag_data.openprcount = ag_data.prcount
    
    # 8. RECALCULATE ALL PERCENTAGES
    if ag_data.commitlinesmodified > 0:
        ag_data.newwork_pct = (ag_data.newwork / ag_data.commitlinesmodified) * 100
        ag_data.rework_pct = (ag_data.rework / ag_data.commitlinesmodified) * 100
        ag_data.maintenance_pct = (ag_data.maintenancework / ag_data.commitlinesmodified) * 100
    
    if ag_data.prcount > 0:
        ag_data.pr_reviewed_pct = ((ag_data.prcount - ag_data.unreviewedprcount) / ag_data.prcount) * 100
        ag_data.pr_unreviewed_pct = (ag_data.unreviewedprcount / ag_data.prcount) * 100
        ag_data.pr_merged_pct = (ag_data.prmergedcount / ag_data.prcount) * 100
        ag_data.pr_open_pct = (ag_data.openprcount / ag_data.prcount) * 100
        ag_data.pr_large_pct = (ag_data.largesizeprcount / ag_data.prcount) * 100
    
    if reviewed_count > 0:
        ag_data.flashy_reviews_pct = (ag_data.flashyreviewedprcount / reviewed_count) * 100
    
    if ag_data.deploymentfrequency > 0:
        ag_data.cfr_pct = (ag_data.hotfixprcount / ag_data.deploymentfrequency) * 100
    
    if ag_data.hotfixprcount > 0:
        ag_data.mttr = ag_data.prmttrduration / ag_data.hotfixprcount
    
    # 9. VERIFY ALL CONSTRAINTS
    assert 99 <= (ag_data.newwork_pct + ag_data.rework_pct + ag_data.maintenance_pct) <= 101
    assert 99 <= (ag_data.pr_reviewed_pct + ag_data.pr_unreviewed_pct) <= 101
    assert ag_data.flashyreviewedprcount <= reviewed_count
    assert ag_data.cfr_pct <= 100
    
    return ag_data
```

