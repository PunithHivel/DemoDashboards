{
  "version": "1.0",
  "metrics": [
    {
      "id": "pr_opened",
      "label": "PRs opened",
      "unit": "count",
      "source": "pull_request.createdon",
      "affects": ["pr_opened"],
      "actions": ["shift_open_prs"]
    },
    {
      "id": "pr_merged",
      "label": "Merged PRs",
      "unit": "count",
      "source": "pull_request.mergedon",
      "affects": [
        "pr_merged",
        "pr_reviewed",
        "pr_unreviewed",
        "flashy_reviews",
        "large_prs",
        "review_time",
        "cycle_time",
        "delivery_lead_time",
        "deploy_time",
        "coding_time",
        "release_prs",
        "deployment_frequency",
        "hotfix_prs"
      ],
      "actions": ["shift_merged_prs"]
    },
    {
      "id": "pr_reviewed",
      "label": "Reviewed PRs",
      "unit": "count",
      "source": "pull_request.approvedon",
      "affects": ["pr_reviewed", "pr_unreviewed", "flashy_reviews"],
      "actions": ["set_reviewed_count"]
    },
    {
      "id": "pr_unreviewed",
      "label": "Unreviewed merged PRs",
      "unit": "count",
      "source": "pull_request.approvedon",
      "affects": ["pr_unreviewed", "pr_reviewed", "flashy_reviews"],
      "actions": ["set_unreviewed_count"]
    },
    {
      "id": "flashy_reviews",
      "label": "Flashy reviews (> 400 lines, < 5 min)",
      "unit": "count",
      "source": "pull_request.opentoreviewduration",
      "affects": ["flashy_reviews"],
      "actions": ["set_flashy_reviews"]
    },
    {
      "id": "large_prs",
      "label": "Large PRs (lines added + removed > 400)",
      "unit": "count",
      "source": "pull_request.linesadded + pull_request.linesremoved",
      "affects": ["large_prs"],
      "actions": ["set_large_prs"]
    },
    {
      "id": "review_time",
      "label": "Review time (avg minutes)",
      "unit": "minutes",
      "source": "pull_request.opentoreviewduration",
      "affects": ["review_time", "cycle_time"],
      "actions": ["scale_review_time"]
    },
    {
      "id": "cycle_time",
      "label": "Cycle time (avg minutes)",
      "unit": "minutes",
      "source": "pull_request.cycletimeduration",
      "affects": ["cycle_time", "large_prs", "delivery_lead_time"],
      "actions": ["scale_cycle_time"]
    },
    {
      "id": "delivery_lead_time",
      "label": "Delivery lead time (avg minutes)",
      "unit": "minutes",
      "source": "pull_request.cycletimeduration + pull_request.mergetodeployduration",
      "affects": ["delivery_lead_time"],
      "actions": []
    },
    {
      "id": "deploy_time",
      "label": "Deploy time (avg minutes)",
      "unit": "minutes",
      "source": "pull_request.deploytimeduration",
      "affects": ["deploy_time", "cycle_time"],
      "actions": ["scale_deploy_time"]
    },
    {
      "id": "coding_time",
      "label": "Coding time (avg minutes)",
      "unit": "minutes",
      "source": "pull_request.committoopenduration",
      "affects": ["coding_time", "cycle_time"],
      "actions": ["scale_coding_time"]
    },
    {
      "id": "release_prs",
      "label": "Release PRs (DF)",
      "unit": "count",
      "source": "pull_request.releasebranchpr",
      "affects": ["release_prs", "deployment_frequency"],
      "actions": ["toggle_release_prs"]
    },
    {
      "id": "deployment_frequency",
      "label": "Deployment frequency (release PRs / merged PRs)",
      "unit": "ratio",
      "source": "pull_request.releasebranchpr / pull_request.merged",
      "affects": ["deployment_frequency"],
      "actions": []
    },
    {
      "id": "hotfix_prs",
      "label": "Hotfix PRs",
      "unit": "count",
      "source": "pull_request.hotfixpr",
      "affects": ["hotfix_prs"],
      "actions": ["toggle_hotfix_prs"]
    },
    {
      "id": "mttr",
      "label": "MTTR (avg minutes, hotfix PRs)",
      "unit": "minutes",
      "source": "pull_request.cycletimeduration (hotfix)",
      "affects": ["mttr", "cycle_time", "delivery_lead_time"],
      "actions": ["scale_mttr_duration"]
    },
    {
      "id": "rework_pct",
      "label": "Rework %",
      "unit": "percent",
      "source": "commit.rework/commit.commitlinesmodified",
      "affects": ["rework_pct", "newwork_pct", "maintenance_pct"],
      "actions": ["set_commit_mix"]
    },
    {
      "id": "newwork_pct",
      "label": "New work %",
      "unit": "percent",
      "source": "commit.newwork/commit.commitlinesmodified",
      "affects": ["newwork_pct", "rework_pct", "maintenance_pct"],
      "actions": ["set_commit_mix"]
    },
    {
      "id": "maintenance_pct",
      "label": "Maintenance %",
      "unit": "percent",
      "source": "commit.maintenance/commit.commitlinesmodified",
      "affects": ["maintenance_pct", "rework_pct", "newwork_pct"],
      "actions": ["set_commit_mix"]
    },
    {
      "id": "commit_frequency",
      "label": "Commit frequency",
      "unit": "count",
      "source": "commit.date",
      "affects": ["commit_frequency"],
      "actions": ["shift_commit_dates"]
    },
    {
      "id": "active_days",
      "label": "Active days",
      "unit": "count",
      "source": "commit/pr_update/pr_reviewer/pull_request",
      "affects": ["active_days"],
      "actions": []
    },
    {
      "id": "bulk_shift",
      "label": "Bulk Month Shift",
      "unit": "months",
      "source": "all_tables",
      "affects": ["pr_opened", "pr_merged", "pr_reviewed", "commits", "commit_mix"],
      "actions": ["bulk_shift_months"]
    }
  ]
}
